<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SmartHadithTree.Domain\SmartHadithTree.Domain.csproj" />
    <ProjectReference Include="..\SmartHadithTree.Application\SmartHadithTree.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Floating like Tools, so consumers (Api, Etl, IlalCompare) get the same EF Core as this assembly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The 11 SQL Server migrations (up to tag pre-postgres), kept for reference only; not compiled. -->
  <ItemGroup>
    <Compile Remove="Data\Migrations.SqlServer\**" />
    <None Include="Data\Migrations.SqlServer\**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
