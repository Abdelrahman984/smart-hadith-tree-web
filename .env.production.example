# Also needed: the database backup (SmartHadithTree_Shamela_v8_pg_2026-10-21.dump) in ./backups/ - see deploy/devops-handoff.md section 3.
# Copy to `.env` on the server (git-ignored) and fill in. Never commit real values.
WEB_DOMAIN=hadith.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Shared VPS: `caddy` starts the bundled proxy (needs free ports 80/443). Leave EMPTY if the host already
# runs its own reverse proxy; then route the two domains to 127.0.0.1:API_PORT / WEB_PORT yourself.
COMPOSE_PROFILES=caddy
# Host ports (bound to 127.0.0.1 only). Change if they clash with other projects on the VPS.
WEB_PORT=3100
API_PORT=5147

# Password of the `sht` PostgreSQL user (the database is only reachable inside the compose network).
# Set it before the first `up`: PostgreSQL reads it only when it creates the data volume.
POSTGRES_PASSWORD=

# Optional LLM keys. With neither, the site works but AI summaries, Ilal explanations
# and the /verify model review are off. Together takes precedence over Gemini.
TOGETHER_API_KEY=
# Together model name; the default is used when this line is left out.
TOGETHER_MODEL=zai-org/GLM-5.3-Flash
# Extra JSON fields sent with every chat request. For zai-org/GLM-5.3-Flash on Together this turns the model's
# long "thinking" down: the search AI check dropped from 8-27 s to 3-4 s (measured with scripts/model_latency.py).
# Keep the single quotes. Leave empty for other models, and re-measure before changing the model.
TOGETHER_EXTRA_BODY='{"reasoning_effort":"low"}'
GEMINI_API_KEY=
VERIFY_REVIEW_TIMEOUT_SECONDS=8
